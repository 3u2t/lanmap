# LANMap (local dev)
PORT=8081
DATA_DIR=./data
DEMO_MODE=false
SCAN_CONCURRENCY=32
MONITOR_INTERVAL_MS=10000
PING_TIMEOUT_MS=1500
OFFLINE_AFTER_FAILURES=3
SESSION_TTL_HOURS=24
AGENT_SECRET=change-me-to-a-long-random-string
TZ=UTC
# In Docker bridge mode /proc/net/route only shows the Docker gateway (172.x).
# Then set your real gateway/subnet here — or use network_mode: host.
# GATEWAY_IP=192.168.178.1
# LAN_SUBNET=192.168.178.0/24
